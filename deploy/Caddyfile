{
	email {$ACME_EMAIL}
	admin off
}

www.job-agent.dk {
	header -Server
	redir https://job-agent.dk{uri} permanent
}

job-agent.dk {
	encode zstd gzip
	redir /about /om/ permanent
	redir /about/ /om/ permanent
	redir /privacy /privatliv/ permanent
	redir /privacy/ /privatliv/ permanent

	header {
		-Server
		Content-Security-Policy "default-src 'self'; img-src 'self' data: https:; script-src 'self'; style-src 'self'; font-src 'self'; connect-src 'self'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'; upgrade-insecure-requests"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		Referrer-Policy "strict-origin-when-cross-origin"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Link "</.well-known/mcp/server-card.json>; rel=\"service-desc\"; type=\"application/json\", </llms.txt>; rel=\"alternate\"; type=\"text/plain\""
	}

	@mcp path /mcp /mcp/*
	handle @mcp {
		request_body {
			max_size 128KB
		}
		header Cache-Control "no-store"
		reverse_proxy mcp:3004 {
			flush_interval -1
		}
	}

	handle /health {
		reverse_proxy mcp:3004
	}

	@fingerprints path_regexp fingerprints ^/index-[a-z0-9]+\.(css|js)$
	header @fingerprints Cache-Control "public, max-age=31536000, immutable"
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=86400"
	@pages path / /om/* /privatliv/* /kontakt/*
	header @pages Cache-Control "public, max-age=300"

	@machine path *.xml *.txt *.json /.well-known/*
	@apiCatalog path /.well-known/api-catalog
	header @apiCatalog Content-Type "application/json; charset=utf-8"
	handle @machine {
		root * /srv
		file_server
	}

	handle {
		root * /srv
		try_files {path} {path}/index.html /index.html
		file_server
	}
}
