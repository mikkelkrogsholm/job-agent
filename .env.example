# Optional runtime overrides. The defaults are shown here.
JOBNET_BASE_URL=https://jobnet.dk/bff
JOBBANK_BASE_URL=https://jobbank.dk
JOBINDEX_BASE_URL=https://www.jobindex.dk
JOBDANMARK_BASE_URL=https://jobdanmark.dk
JOBNET_TIMEOUT_MS=15000
JOBBANK_TIMEOUT_MS=15000
JOBINDEX_TIMEOUT_MS=15000
JOBDANMARK_TIMEOUT_MS=15000

# Used by an HTTP entry point. Each provider otherwise chooses its own port.
MCP_HOST=127.0.0.1
MCP_PORT=3000

# Optional local deployment helpers. These are not read by the application.
HETZNER_IP=203.0.113.10
DNS=job-agent.dk
REPO=https://github.com/your-user/job-agent.git
